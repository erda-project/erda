{
  "kimi-k3": {
    "placeholders": [
      {
        "name": "target-model-name",
        "type": "string",
        "required": false,
        "default": "${@template.name}"
      }
    ],
    "metadata": {
      "recommended_service_provider_templates": [
        "aliyun-bailian"
      ],
      "website": "https://bailian.console.aliyun.com/cn-beijing/?tab=model#/model-market/detail/kimi-k3"
    },
    "desc": "Kimi-K3 是月之暗面目前能力最强的旗舰模型，拥有 2.8 万亿参数，原生支持视觉理解与 100 万 token 上下文，面向长程编程、知识工作和推理等前沿场景。",
    "config": {
