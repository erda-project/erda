            "max_reasoning_tokens": 1000000,
            "rpm": 15000,
            "tpm": 1200000
          },
          "pricing": {
            "prompt": "0.000020",
            "completion": "0.000100",
            "request": "0",
            "image": "0",
            "web_search": "0",
            "internal_reasoning": "0",
            "input_cache_read": "0.000002",
            "input_cache_write": "0",
            "unit": "CNY"
          },
          "model_name": "${@template.placeholders.target-model-name}"
        },
        "secret": {}
      }
    }
  }
}
